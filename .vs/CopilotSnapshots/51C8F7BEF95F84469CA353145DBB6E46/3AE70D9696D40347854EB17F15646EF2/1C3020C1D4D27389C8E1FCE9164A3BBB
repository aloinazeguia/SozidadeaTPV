<!-- ============================================================
  AppTpv — Mahaien mapa: 7 mahaien egoera bisuala
    librea / erreserbatuta / okupatuta (eskaera irekiarekin)
============================================================ -->
<UserControl x:Class="BezeroaWPF.Ikuspegiak.MahaiMapaIkuspegia"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Arial">
    <Grid Background="#F4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Goiburua -->
        <DockPanel Grid.Row="0" Background="#2E3440">
            <Button DockPanel.Dock="Right" x:Name="BtnFreskatu" Content="Freskatu"
                    Width="96" Height="34" Margin="0,0,20,0" FontSize="13"
                    Background="#6FC16E" Foreground="#2E3440" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand" Click="BtnFreskatu_Click"/>
            <TextBlock Text="MAHAIEN MAPA" Foreground="White" FontSize="22"
                       FontWeight="Bold" Margin="24,14"/>
        </DockPanel>

        <!-- Mahai-txartelak -->
        <ScrollViewer x:Name="MapaPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ListaMahaiak" Margin="24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="210" Height="158" CornerRadius="12" Margin="10"
                                Padding="16" BorderBrush="#C9D3DF" BorderThickness="1"
                                Cursor="Hand"
                                MouseLeftButtonUp="MahaiKlik">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#DFF0E3"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Egoera}" Value="erreserbatuta">
                                            <Setter Property="Background" Value="#FFF3D6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Egoera}" Value="okupatuta">
                                            <Setter Property="Background" Value="#FADBD8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding MahaiZenbakia, StringFormat={}{0}. MAHAIA}"
                                           FontSize="20" FontWeight="Bold" Foreground="#2E3440"/>
                                <TextBlock Text="{Binding Edukiera, StringFormat=Edukiera: {0} plaza}"
                                           FontSize="13" Foreground="#4C566A" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding EgoeraErakutsi}"
                                           FontSize="16" FontWeight="Bold" Foreground="#2E3440"
                                           Margin="0,16,0,0"/>
                                <TextBlock Text="{Binding EskaeraErakutsi}"
                                           FontSize="12" Foreground="#4C566A" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Erreserba-formularioa: mahi batean klik egitean bistaratzen da -->
        <Border x:Name="FormaPanel" Grid.Row="1" Background="#F4F6F8"
                Visibility="Collapsed">
            <Border Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="White" CornerRadius="10" Padding="24"
                    BorderBrush="#C9D3DF" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="TxtFormaIzenburua" Text="Erreserba berria"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

                    <TextBlock Text="Mahaia:"/>
                    <TextBlock x:Name="TxtMahia" FontWeight="Bold" Margin="0,2,0,10"/>

                    <TextBlock Text="Txanda:"/>
                    <ComboBox x:Name="CboTxanda" Margin="0,2,0,10" SelectedIndex="0">
                        <ComboBoxItem Content="bazkaria"/>
                        <ComboBoxItem Content="afaria"/>
                    </ComboBox>

                    <TextBlock Text="Pertsona kopurua:"/>
                    <TextBox x:Name="TxtPertsonak" Text="2" Margin="0,2,0,10"
                             TextChanged="TxtPertsonak_TextChanged"/>

                    <TextBlock Text="Data (hutsik = datarik gabe; gaurtik aurrera):"/>
                    <DatePicker x:Name="DtpData" Margin="0,2,0,10"
                                SelectedDateChanged="DtpData_SelectedDateChanged"/>

                    <TextBlock Text="Bezeroaren izena:"/>
                    <TextBox x:Name="TxtBezeroa" Margin="0,2,0,10"/>

                    <TextBlock Text="Oharrak (aukerakoa):"/>
                    <TextBox x:Name="TxtOharrak" Margin="0,2,0,10"/>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnSortu" Content="Sortu" Width="90"
                                Background="#2E7D32" Foreground="White" Click="BtnSortu_Click"/>
                        <Button x:Name="BtnUtzi" Content="Utzi" Width="80" Margin="6,0,0,0"
                                Click="BtnUtzi_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtAbisua" Foreground="Red" TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Erreserba aktiboak" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  data-iragazkia (hutsik = guztiak): " VerticalAlignment="Center"/>
                <TextBox x:Name="TxtDataIragazkia" Width="100"/>
                <Button x:Name="BtnEguneratu" Content="Eguneratu" Width="90" Margin="8,0,0,0"
                        Click="BtnEguneratu_Click"/>
                <TextBlock x:Name="TxtErreserbaAbisua" Foreground="#B03A2E"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <DataGrid x:Name="GridErreserbak" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ErreserbaId}" Width="40"/>
                    <DataGridTextColumn Header="Mahaia" Binding="{Binding MahaiZenbakia}" Width="60"/>
                    <DataGridTextColumn Header="Data" Binding="{Binding DataErakutsi}" Width="110"/>
                    <DataGridTextColumn Header="Txanda" Binding="{Binding Txanda}" Width="80"/>
                    <DataGridTextColumn Header="Pertsonak" Binding="{Binding PertsonaKopurua}" Width="80"/>
                    <DataGridTextColumn Header="Bezeroa" Binding="{Binding BezeroIzena}" Width="*"/>
                    <DataGridTextColumn Header="Oharrak" Binding="{Binding Oharrak}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
        <!-- Oinarria: egoeren legeenda -->
        <DockPanel Grid.Row="3" Background="#EEEEEE" LastChildFill="False">
            <TextBlock Text="Librea" Foreground="#1E7A52" FontWeight="Bold" Margin="24,8,0,8"/>
            <TextBlock Text="Erreserbatuta" Foreground="#B03A2E" FontWeight="Bold" Margin="24,8,0,8"/>
            <!--<TextBlock Text="Okupatuta" Foreground="#B03A2E" FontWeight="Bold" Margin="24,8,0,8"/>-->
            <TextBlock x:Name="TxtMapaInfo" Foreground="#55606D" FontSize="11"
                       DockPanel.Dock="Right" Margin="0,8,24,8" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</UserControl>
